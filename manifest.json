{
  "manifest_version": 3,
  "name": "HoldTab - Background Link Opener",
  "version": "1.9.0",
  "description": "Open links in background tabs without leaving your current tab using mouse gestures, tab cycling, and floating text selection toolbar.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "clipboardRead"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "HoldTab Settings"
  },
  "commands": {
    "quick-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open HoldTab Quick Search"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "scripts": ["utils/site-status.js", "background/service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/site-status.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "holdtab@local.addon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
